# Required production configuration
UPSTOX_STREAM_ENABLED=1
UPSTOX_ACCESS_TOKEN=
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_TOKEN=replace-with-a-long-random-secret

# Compatibility: NEON_DATABASE_URL takes precedence; DATABASE_URL is accepted as an alias.
# DATABASE_URL=

# Application runtime
APP_ENV=production
TZ=Asia/Kolkata
AUTOSTART=1
RUN_SCHEDULER=1
UPSTOX_STREAM_ENABLED=1
REQUIRE_PERSISTENT_DB=1
KEEPALIVE=1
LOG_LEVEL=INFO

# Existing strategy parameters — preserved; do not change without strategy approval.
N_ADX_MIN=22
N_SL_ATR=1.2
N_TP1_R=1.5
N_TP2_R=2.0
N_LAST_ENTRY=15:00
N_SESSION_END=15:15

# Data reliability / scanner controls
FETCH_DELAY_SEC=6
STALE_MAX_BARS=1
WORKERS=6
RATE_PER_SEC=8
RATE_PER_MIN=400
RATE_PER_30MIN=1700
DRY_RUN=0
OPTION_QUOTE=0
OPTION_MARKET_SNAPSHOT=0
OPTION_LIQUIDITY_CHECKS=0
OPTION_MIN_VOLUME=100
OPTION_MIN_OI=500
OPTION_MAX_SPREAD_PCT=3.0
OPTION_MAX_QUOTE_AGE_SEC=20

# Round-trip cost assumption in underlying R units; set from measured fees/slippage.
TRAINING_COST_R=0.0
