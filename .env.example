# TEMPLATE ONLY — copy to .env locally; never commit real credentials.
# Set the required secret values in Render Dashboard → Environment.
# Do not paste tokens, database URLs, or passwords into GitHub.

# Required production secrets (no defaults; configure in Render)
# Preferred: Upstox Analytics Token (read-only, 1-year validity).
UPSTOX_ANALYTICS_TOKEN=
# Backwards-compatible fallback only; do not set both unless rotating.
# UPSTOX_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
ADMIN_TOKEN=replace-with-a-long-random-secret

# Compatibility only: NEON_DATABASE_URL takes precedence.
# DATABASE_URL=

# Application / infrastructure
TZ=Asia/Kolkata
AUTOSTART=1
RUN_SCHEDULER=1
UPSTOX_STREAM_ENABLED=1
REQUIRE_PERSISTENT_DB=1
KEEPALIVE=1
LOG_LEVEL=INFO
ENABLE_NORMAL=1
ENABLE_MOMENTUM=0
DRY_RUN=0

# Scanner and Upstox request pacing
FETCH_DELAY_SEC=6
STALE_MAX_BARS=1
WORKERS=24
RATE_PER_SEC=15
RATE_PER_MIN=450
RATE_PER_30MIN=1800
PREWARM_NSE=08:40
HEARTBEAT_MIN=60
EOD_SUMMARY=1

# Existing Normal 5-minute strategy parameters — preserve approved rules
N_FIRST_SIGNAL=09:20
N_LAST_ENTRY=15:00
N_SESSION_END=15:15
N_ADX_MIN=20
N_SCORE_MIN=72
N_SL_ATR=1.2
N_TP1_R=1.5
N_TP2_R=2.0
N_DAILY_CAP=1000
N_PER_CYCLE_TOP=1000

# Retired Momentum settings below are ignored; production runs Normal only.
M_FIRST_SIGNAL=09:20
M_LAST_ENTRY=15:00
M_SESSION_END=15:15
M_SCORE_MIN=78
M_COOLDOWN_BARS=2
M_DAILY_CAP=1000
M_PER_CYCLE_TOP=1000

# Option contract display / required liquidity validation
OPTION_MIN_DAYS=1
OPTION_QUOTE=0
OPTION_MARKET_SNAPSHOT=1
OPTION_LIQUIDITY_CHECKS=0
OPTION_MIN_VOLUME=100
OPTION_MIN_OI=500
OPTION_MAX_SPREAD_PCT=3.0
OPTION_MAX_QUOTE_AGE_SEC=20

# Outcome tracking and cost estimates (descriptive; do not change signal gates)
OPTION_PREMIUM_TRACKING=1
TRAINING_COST_R=0.0
OPTION_EST_ROUND_TRIP_FEE_PCT=0.0
OPTION_EST_SLIPPAGE_BPS_PER_SIDE=0.0
